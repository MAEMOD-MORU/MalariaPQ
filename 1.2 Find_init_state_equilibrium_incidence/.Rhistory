# --- Step 1: Create initial dataset ---
old_arms <- c("Baloxavir", "Favipiravir", "Molnupiravir", "Oseltamivir", "No study drug")
K <- 100
block_size <- length(old_arms)
N_old <- K * block_size
# randomize old participants
old_rand <- unlist(replicate(K, sample(old_arms, block_size), simplify = FALSE))
old_data <- data.frame(ID = 1:N_old, Drug = old_rand)
barplot(table(old_data$Drug), col = "skyblue", main = "Original randomization counts")
# --- Step 2: Remove one drug (Favipiravir) ---
remove_drug <- "Favipiravir"
remaining_data <- subset(old_data, Drug != remove_drug)
remaining_arms <- setdiff(old_arms, remove_drug)
barplot(table(remaining_data$Drug), col = "tomato", main = paste("Remaining sample after removing", remove_drug))
# --- Step 3: Add new drug (Remdesivir) with 100 new participants ---
new_drug <- "Remdesivir"
n_new <- 100
new_data <- data.frame(
ID = max(remaining_data$ID) + 1:n_new,
Drug = rep(new_drug, n_new)
)
# --- Step 4: Combine remaining + new ---
updated_data <- rbind(remaining_data, new_data)
barplot(table(updated_data$Drug), col = "lightgreen",
main = "Remaining + new participants (with new drug)")
# --- Step 3: Add a new drug (e.g. Remdesivir) for new participants ---
new_drug <- "Remdesivir"
new_arms <- c(setdiff(arms, remove_drug), new_drug)
# Generate randomization for 100 new participants
set.seed(2)
n_new <- 100
block_size <- length(new_arms)
K_new <- ceiling(n_new / block_size)
rand_seq_new <- unlist(replicate(K_new, sample(new_arms, block_size), simplify = FALSE))
rand_seq_new <- rand_seq_new[1:n_new]
new_data <- data.frame(ID = (N_total + 1):(N_total + n_new),
Drug = rand_seq_new)
# Combine the remaining + new data for updated trial
updated_data <- rbind(remaining_after_removal, new_data)
# --- Plot 3: Remaining + New allocation (after adaptation) ---
barplot(table(updated_data$Drug),
col = "lightgreen",
main = paste("Updated randomization after adding", new_drug),
ylim = c(0, 120))
