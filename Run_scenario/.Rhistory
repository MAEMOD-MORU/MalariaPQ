legend("topleft", c("Asymptomatic", "Symptomatic"), col = c(3, 4), lty = c(1, 1))
legend("right", c("Baseline D1 66%", "D1 33% + D2 33%","D2 66%"), col = c(1), lty = c(1, 2, 3),lwd=2)
abline(v=2025,lty=2)
text(2024,1.5e07,"Start D2")
