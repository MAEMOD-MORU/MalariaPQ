# Run Simulation
library(deSolve)
#Read model
source("model_D0_33_D1_67_baseline_change_birth_death_2betaSets.r")
source("model_D0_33_D2_67_baseline_change_birth_death_2betaSets.r")
#
source("init_parameter_equilibrium_birth_2_rate_2beta_res_fitted.R")
totalpop <- read.csv("data/uganda_totalpop_2000_2100.csv", header = TRUE)
uganda_Incidence <- read.csv("data/uganda_Incidence.csv")
init_state <- readRDS("init_state.rds")
plot(2000:2022,uganda_Incidence[1:23, 2], type = "b",
xlab = "Years", ylab = "Incidence",
main = "Total Incidence from data",
xlim = c(2000,2022),
col = 1, ylim = c(0, 1.1 * max(uganda_Incidence[1:23, 2])))
abline(v=2009,lty=2)
text(2006,0.5e7,"ITN and IRS\n[1],[2]")
abline(v=2014,lty=2)
text(2016.5,0.5e7,"Artemisinin\n Resistance\n Detected\n[3]")
events <- list(
func = function(time, state, parameters) {
if (time == 12 * 14) {
print(paste("Event triggered at time", time))
state["Ir0"] <- state["Ir0"] + state["Is0"] * 0.05
state["Ir1"] <- state["Ir1"] + state["Is1"] * 0.05
state["Ir2"] <- state["Ir2"] + state["Is2"] * 0.05
state["Ar"] <- state["Ar"] + state["As"] * 0.05
# reduce Is
state["Is0"] <- state["Is0"] *0.95
state["Is1"] <- state["Is1"] *0.95
state["Is2"] <- state["Is2"] *0.95
state["As"] <- state["As"] *0.95
# state["S"] <- state["S"] - (
#   state["Is0"] * 0.05 +
#     state["Is1"] * 0.05 +
#     state["Is2"] * 0.05 +
#     state["As"] * 0.05
# )
}
return(state)
},
time = 12 * 14  # only one time point
)
times <- seq(0, 12*51, 1) # 12 months per year, 23 years
parameters_drug <- parameters
parameters_drug$start_d <- 12*26 #2025
parameters_drug_2 <- parameters_drug
out<- ode(y = init_state, times = times,
func = Malaria_model_with_Array,
parms = parameters,events=events)
out_s1<- ode(y = init_state, times = times,
func = Malaria_model_with_Array,
parms = parameters_drug,events=events)
out_s2<- ode(y = init_state, times = times,
func = Malaria_model_with_Array_d2,
parms = parameters_drug_2,events=events)
plot(out[,"inc"],type="l",xlab="Months",ylab="Incidence",main="Total Incidence (Baseline D1 66%)")
lines(out_s1[,"inc"],col=2)
lines(out_s2[,"inc"],col=3)
plot(out[,"G_inc"],type="l",xlab="Months",ylab="Incidence",main="Total Incidence (Baseline D1 66%)")
lines(out_s1[,"G_inc"],col=2)
lines(out_s2[,"G_inc"],col=3)
plot(out[,"GS_inc"],type="l",xlab="Months",ylab="Incidence",main="Total Incidence (Baseline D1 66%)")
lines(out_s1[,"GS_inc"],col=2)
lines(out_s2[,"GS_inc"],col=3)
plot(out[,"GR_inc"],type="l",xlab="Months",ylab="Incidence",main="Total Incidence (Baseline D1 66%)")
lines(out_s1[,"GR_inc"],col=2)
lines(out_s2[,"GR_inc"],col=3)
# out,out_s1,out_s2 Is0 to Is2 and Ir0 to Ir2
plot(out[,"Is0"],type="l",xlab="Months",ylab="Incidence",main="Total Incidence (Baseline D1 66%)")
lines(out_s1[,"Is0"],type="l",col="red")
lines(out_s2[,"Is0"],type="l",col="blue")
plot(out[,"Is1"],type="l",xlab="Months",ylab="Incidence",main="Total Incidence (Baseline D1 66%)")
lines(out_s1[,"Is1"],type="l",col="red")
lines(out_s2[,"Is1"],type="l",col="blue")
plot(out[,"Is2"],type="l",xlab="Months",ylab="Incidence",main="Total Incidence (Baseline D1 66%)")
lines(out_s1[,"Is2"],type="l",col="red")
lines(out_s2[,"Is2"],type="l",col="blue")
plot(out[,"GIs1"],type="l",xlab="Months",ylab="Incidence",main="Total Incidence (Baseline D1 66%)")
lines(out_s1[,"GIs1"],type="l",col="red")
lines(out_s2[,"GR_inc"],col=3)
# divide each into 12
monthly <- rep(uganda_Incidence[,2] / 12, each = 1)  # 12 points per value
monthly_pop <- as.vector(sapply(monthly, function(x) rep(x, 12)))
plot(seq(2000,2051,1/12),out[,"inc"],type="l",xlab="Years",ylab="Incidence",main="Total Incidence",col=1,ylim = c(0,1.1*max(out[,"inc"])))
abline(v=2014,lty=2)
text(2011,2e6,"Add\n Resistant")
# Define all variables you want to collect
vars_all <- colnames(out)
# Preallocate matrix
out_in_year <- matrix(0, nrow = 51, ncol = length(vars_all) + 1)
out_in_year_S1 <- out_in_year
out_in_year_S2 <- out_in_year
colnames(out_in_year) <- c("year", vars_all)
colnames(out_in_year_S1) <- c("year", vars_all)
colnames(out_in_year_S2) <- c("year", vars_all)
n_years <- floor(nrow(out) / 12)
# Fill the matrix
for (i in 1:n_years) {
start_idx <- 12 * (i - 1) + 1
end_idx <- 12 * i
out_in_year[i, "year"] <- 2000 + (i - 1)
out_in_year_S1[i, "year"] <- 2000 + (i - 1)
out_in_year_S2[i, "year"] <- 2000 + (i - 1)
# print(i)
for (v in vars_all) {
if (v %in% colnames(out)) {
if (v == "N") {
out_in_year[i, v] <- out[end_idx, v]  # use last month
out_in_year_S1[i, v] <- out_s1[end_idx, v]  # use last month
out_in_year_S2[i, v] <- out_s2[end_idx, v]  # use last month
} else {
out_in_year[i, v] <- sum(out[start_idx:end_idx, v])  # sum over year
out_in_year_S1[i, v] <- sum(out_s1[start_idx:end_idx, v])  # use last month
out_in_year_S2[i, v] <- sum(out_s2[start_idx:end_idx, v])  # use last month
}
} else {
out_in_year[i, v] <- NA  # mark missing variables as NA
}
}
}
out_in_year <- out_in_year[, colnames(out_in_year) != "time"]
out_in_year_S1 <- out_in_year_S1[, colnames(out_in_year_S1) != "time"]
out_in_year_S2 <- out_in_year_S2[, colnames(out_in_year_S2) != "time"]
# total incidence
plot(out_in_year[, 1], out_in_year[, "inc"], type = "l",
xlab = "Years", ylab = "Incidence",
main = "Total Incidence by Year",
xlim = c(2014,2035),lwd = 2,
col = 1, ylim = c(0, 1.1 * max(out_in_year[1:35, "inc"])))
points(2000:2022, uganda_Incidence[1:23, 2], col = "red",pch=19)
lines(out_in_year_S1[, 1], out_in_year_S1[, "inc"], lty=2,lwd = 2)
lines(out_in_year_S2[, 1], out_in_year_S2[, "inc"], lty=3,lwd = 2)
legend("right", c("Model", "Data"), col = c(1, 2), lty = c(1, NA), pch = c(NA, 19))
legend("bottomright", c("Baseline D1 66%", "D1 33% + D2 33%","D2 66%"), col = c(1), lty = c(1, 2, 3),lwd=2)
abline(v=2015,lty=2)
text(2024,2e07,"Start D2")
abline(v=2025,lty=2)
text(2024,2e07,"Start D2")
