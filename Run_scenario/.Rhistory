xlab = "Years", ylab = "Incidence",
main = "Incidence Asymptomatic/Symptomatic by Year",
xlim = c(2014,2035),lwd = 2,
col = 3, ylim = c(0, 1.1 * max(out_in_year[1:35, "inc_asym"])))
