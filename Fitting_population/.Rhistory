### --- Step 1: Simulate old randomization (before adaptation) ---
set.seed(1)
# Starting drug arms
arms <- c("Baloxavir", "Favipiravir", "Molnupiravir", "Oseltamivir", "No study drug")
Block_size <- length(arms)
K <- 100
N_total <- K * Block_size  # total = 500
# Create the randomization sequence
rand_seq <- unlist(replicate(K, sample(arms, Block_size), simplify = FALSE))
old_data <- data.frame(ID = 1:N_total, Drug = rand_seq)
# Suppose first 142 participants have already been enrolled
enrolled <- old_data[1:142, ]
remaining <- old_data[143:N_total, ]
# --- Plot 1: Original randomization ---
barplot(table(old_data$Drug),
col = "skyblue",
main = "Original randomization (before adaptation)",
ylim = c(0, 120))
# --- Plot 2: remaining randomization ---
barplot(table(remaining$Drug),
col = "skyblue",
main = "Original randomization (before adaptation)",
ylim = c(0, 120))
### --- Step 2: Remove a drug (e.g. Favipiravir) ---
remove_drug <- "Favipiravir"
remaining_after_removal <- remaining[remaining$Drug != remove_drug, ]
# --- Plot 3: After removing the stopped drug ---
barplot(table(remaining_after_removal$Drug),
col = "salmon",
main = paste("Remaining sample after removing", remove_drug),
ylim = c(0, 120))
### --- Step 3: Add 100 new participants (Remdesivir only) ---
new_drug <- "Remdesivir"
n_new <- 100
# Create new data for the new drug only
new_data <- data.frame(
ID = (max(old_data$ID) + 1):(max(old_data$ID) + n_new),
Drug = rep(new_drug, n_new)
)
# Combine: remaining (after removing stopped drug) + new Remdesivir participants
