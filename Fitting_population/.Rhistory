#pop 2000
rmsd <- function(totalpop_model){
diff <- (totalpop_model - totalpop_data)^2
mean_sq <- sum(diff)/length(totalpop_data)
return(sqrt(mean_sq))
}
times <- seq(0,12*51)
#pop 2000-2100
pop_run <- function(pars,dat){
parameters$mui <- pars[1]
parameters$muo <- pars[2]
times
