### --- Step 3: Add new drug (e.g., Remdesivir) for NEW 100 participants ---
new_drug <- "Remdesivir"
active_arms <- c(setdiff(arms, remove_drug), new_drug)
# Only new participants get randomized across active arms
set.seed(123)
n_new <- 100
block_size <- length(active_arms)
K_new <- ceiling(n_new / block_size)
rand_seq_new <- unlist(replicate(K_new, sample(active_arms, block_size), simplify = FALSE))
rand_seq_new <- rand_seq_new[1:n_new]
new_data <- data.frame(
ID = (max(old_data$ID) + 1):(max(old_data$ID) + n_new),
Drug = rand_seq_new
)
# Combine: remaining (after removing stopped drug) + new randomizations
updated_data <- rbind(remaining_after_removal, new_data)
# --- Plot 3: Combined remaining + new participants ---
barplot(table(updated_data$Drug),
col = "lightgreen",
main = paste("Remaining + 100 new (add", new_drug, ")"),
ylim = c(0,120))
