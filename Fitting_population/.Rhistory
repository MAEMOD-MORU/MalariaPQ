ID = (max(enrolled$ID) + 1):(max(enrolled$ID) + N_update),
Drug = rand_seq_update
)
# Combine with already enrolled ones
final_data <- rbind(enrolled, updated_data)
### --- Step 4: Visualize ---
par(mfrow = c(1,3))
# 1. Original
barplot(table(old_data$Drug),
col = "skyblue", main = "Original (before adaptation)",
ylim = c(0,120))
# 2. After removing stopped drug
barplot(table(remaining$Drug[remaining$Drug != remove_drug]),
col = "salmon", main = paste("Remaining (no", remove_drug, ")"),
ylim = c(0,120))
# 3. After adding new drug and re-randomizing
barplot(table(updated_data$Drug),
col = "lightgreen", main = paste("Re-randomized (add", new_drug, ")"),
ylim = c(0,120))
par(mfrow = c(1,1))
arms <- c("Baloxavir", "Favipiravir", "Molnupiravir", "Oseltamivir", "No study drug")
Block_size <- length(arms)
K <- 100
N_total <- K * Block_size  # 500 total
# Randomization for 500 participants
rand_seq <- unlist(replicate(K, sample(arms, Block_size), simplify = FALSE))
old_data <- data.frame(ID = 1:N_total, Drug = rand_seq)
# Split into enrolled (142) and remaining (358)
enrolled <- old_data[1:142, ]
remaining <- old_data[143:N_total, ]
# --- Plot 1: Original randomization ---
barplot(table(old_data$Drug),
col = "skyblue",
